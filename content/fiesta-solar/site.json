              "mobile": {
                "position": {
                  "x": 50,
                  "y": 74
                },
                "size": {
                  "width": 70
                }
              },
              "animations": [
                {
                  "type": "translateY",
                  "trigger": "loop",
                  "from": 0,
                  "to": -26,
                  "duration": 5200,
                  "yoyo": true,
                  "easing": "easeInOut"
                }
              ]
            }
          ]
        },
        {
          "id": "capa-texto-fiesta",
          "depth": 0,
          "elements": [
            {
              "type": "text",
              "id": "kicker-fiesta",
              "content": "¡ESTÁS INVITADO!",
              "semanticTag": "p",
              "position": {
                "x": 58,
                "y": 26
              },
              "fontSize": "clamp(13px, 1.4vw, 17px)",
              "fontWeight": 700,
              "color": "#ff5d8f",
