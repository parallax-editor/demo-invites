        "value": "linear-gradient(180deg, #ffe9c7 0%, #ffd6e5 55%, #cdeffd 100%)"
      },
      "layers": [
        {
          "id": "capa-sol",
          "depth": -0.6,
          "parallaxMode": [
            "scroll-vertical"
          ],
          "elements": [
            {
              "type": "png",
              "id": "sol",
              "src": "images/sol.png",
              "alt": "Sol radiante",
              "position": {
                "x": 80,
                "y": 16
              },
              "size": {
                "width": 24,
                "height": "auto"
              },
              "mobile": {
                "position": {
                  "x": 76,
                  "y": 10
                },
                "size": {
                  "width": 44
                }
              },
              "animations": [
                {
                  "type": "rotate",
                  "trigger": "loop",
                  "from": -6,
                  "to": 6,
                  "duration": 7000,
                  "yoyo": true,
                  "easing": "easeInOut"
                }
              ]
            }
          ]
        },
        {
          "id": "capa-confeti",
          "depth": -0.3,
