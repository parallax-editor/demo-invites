              "mobile": {
                "position": {
                  "x": 50,
                  "y": 32
                }
              },
              "animations": [
                {
                  "type": "fadeIn",
                  "trigger": "enter",
                  "from": 0,
                  "to": 1,
                  "duration": 700
                },
                {
                  "type": "translateY",
                  "trigger": "enter",
                  "from": 40,
                  "to": 0,
                  "duration": 700,
                  "easing": "easeOutCubic"
                }
              ]
            },
            {
              "type": "text",
              "id": "fecha-fiesta",
              "content": "Domingo 29 de noviembre · 3:00 pm · Parque de los Cometas",
              "semanticTag": "p",
              "position": {
                "x": 58,
                "y": 46
              },
              "fontSize": "clamp(14px, 1.6vw, 20px)",
              "fontWeight": 500,
              "color": "#5c4a7d",
              "letterSpacing": "0.06em",
              "textAlign": "center",
              "mobile": {
                "position": {
                  "x": 50,
                  "y": 42
                }
              },
              "animations": [
                {
                  "type": "fadeIn",
                  "trigger": "enter",
                  "from": 0,
                  "to": 1,
                  "duration": 800,
                  "delay": 700
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "rsvp-fiesta",
      "height": "120vh",
      "background": {
        "type": "gradient",
        "value": "linear-gradient(180deg, #cdeffd 0%, #fff7e8 100%)"
      },
      "layers": [
        {
          "id": "capa-rsvp-fiesta",
          "depth": 0,
          "elements": [
            {
              "type": "text",
              "id": "rsvp-titulo-fiesta",
              "content": "¿Vienes a la fiesta?",
              "semanticTag": "h2",
              "position": {
                "x": 50,
                "y": 14
              },
              "font": "Baloo 2",
              "fontSize": "clamp(28px, 4vw, 52px)",
              "fontWeight": 700,
              "color": "#2b2140",
              "textAlign": "center",
              "animations": [
                {
                  "type": "fadeIn",
                  "trigger": "enter",
                  "from": 0,
                  "to": 1,
                  "duration": 800
                }
              ]
            },
            {
              "type": "component",
              "id": "rsvp-form-fiesta",
              "name": "FormBlock",
              "position": {
                "x": 50,
                "y": 50
              },
              "size": {
                "width": "min(88%, 500px)"
              },
              "props": {
                "webhookUrl": "https://httpbin.org/post",
                "fields": [
                  {
                    "name": "nombre",
                    "label": "Nombre del invitado",
                    "type": "text",
                    "required": true
                  },
                  {
                    "name": "asistencia",
                    "label": "¿Asistirá?",
                    "type": "select",
                    "options": [
                      "¡Sí!",
                      "No podrá"
                    ],
                    "required": true
                  },
                  {
                    "name": "ninos",
                    "label": "¿Cuántos niños vienen?",
                    "type": "number"
                  }
                ],
                "submitLabel": "¡Allá estaré!",
                "successMessage": "¡Genial! Nos vemos entre globos y confeti.",
                "errorMessage": "Ups, algo falló — inténtalo otra vez.",
                "honeypotField": "website",
                "styling": {
                  "inputBg": "rgba(255, 255, 255, 0.92)",
                  "inputBorder": "#ff5d8f",
                  "buttonBg": "#ff5d8f",
                  "buttonText": "#ffffff",
                  "fontFamily": "Inter"
                }
              }
            }
          ]
        }
      ]
    }
