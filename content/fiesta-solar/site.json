{
  "schemaVersion": "1.1",
  "meta": {
    "title": "Simón cumple 8 — ¡fiesta solar!",
    "description": "Invitación demo de cumpleaños: globos, confeti y sol en parallax. Preset multi-tenant.",
    "ogImage": "images/og-image.png",
    "fonts": [
      {
        "family": "Baloo 2",
        "source": "google"
      },
      {
        "family": "Inter",
        "source": "google"
      }
    ],
    "lang": "es"
  },
  "theme": {
    "colors": {
      "ink": "#2b2140",
      "paper": "#fff7e8",
      "accent": "#ff5d8f"
    },
    "typography": {
      "display": "Baloo 2",
      "body": "Inter"
    }
  },
  "sections": [
