                  "from": 0,
                  "to": 1,
                  "duration": 800
                }
              ]
            },
            {
              "type": "text",
              "id": "titulo-fiesta",
              "content": "Simón cumple 8",
              "semanticTag": "h1",
              "position": {
                "x": 58,
                "y": 36
              },
              "font": "Baloo 2",
              "fontSize": "clamp(40px, 7vw, 96px)",
              "fontWeight": 700,
              "color": "#2b2140",
              "textAlign": "center",
              "splitMode": "words",
